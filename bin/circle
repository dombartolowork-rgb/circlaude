#!/usr/bin/env python3
"""circle - the Orbit command line, for the SharePoint work the connector cannot do.

Mail, calendar, people and Teams go through the Microsoft 365 connector inside
Claude. This command covers what that connector cannot:

  circle login                       sign in to Microsoft, files and sites only (once)
  circle whoami                      who am I, and what can I do
  circle tracker find SUB133         the Project Tracker: codes, rows, next free code
  circle handover-render plan.json   leave handover: build / upload the Word document
  circle tw-logged --week last       Teamwork: timesheet audit / project codes / logging
  circle yt-get <url>                YouTube / TikTok download, yt-clip for one section (yt-setup once)
  circle vid-cut clip.mp4 --from 4   video: probe / cut / join / sheet / 1080 / pushend (needs ffmpeg)
  circle blender-run script.py -- out  Blender previz and space stills, headless; img-crop for decals
  circle img-gen "prompt" --ref a.png  Nano Banana images, guided by references (Circle's key)

Run `circle <command> --help` for any command's options.
Pure Python 3 stdlib: no pip install needed.
"""
import argparse
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "lib"))

from circle import (blendercmd, graph, handovercmd, imagecmd, teamwork,  # noqa: E402
                    trackercmd, videocmd, ytcmd)


def cmd_login(args):
    from circle import graph_auth
    graph_auth.login()


def cmd_whoami(args):
    """Show both identities, so it is obvious what is wired up and what is not."""
    print("Microsoft (Orbit's own sign-in, for SharePoint files only)")
    try:
        upn, scp = graph.whoami()
        print("  signed in as:", upn)
        print("  token file:  ", graph.TOKEN_FILE)
        print("  app:         ", "Circle app registration" if graph.CLIENT_ID != graph.OFFICE_CLIENT_ID
              else "Microsoft Office (stopgap until IT issue Circle's own app)")
        scopes = sorted(set(scp.split()))
        print("  scopes:      ", ", ".join(scopes) if scopes else "(none)")
    except graph.AuthError as e:
        print("  NOT SIGNED IN:", e)

    print("\nMail, calendar and people come from the Microsoft 365 connector in Claude,")
    print("not from here. If Claude cannot see them, check the connector is switched on.")

    print("\nTeamwork")
    if not os.environ.get("TEAMWORK_API_KEY"):
        print("  TEAMWORK_API_KEY not set, so timesheet commands will not work.")
    else:
        try:
            me = teamwork.api("GET", "/me.json").get("person", {})
            print(f"  signed in as: {me.get('first-name', '')} {me.get('last-name', '')}".rstrip())
            print("  person id:   ", me.get("id"))
            print("  site:        ", teamwork.BASE)
        except teamwork.TeamworkError as e:
            print("  ERROR:", e)


def main():
    parser = argparse.ArgumentParser(
        prog="circle",
        description="The Orbit command line: Project Tracker, SharePoint files, handover, Teamwork, video, Blender and images.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__.split("\n", 2)[2],
    )
    sub = parser.add_subparsers(dest="cmd", required=True, metavar="<command>")

    sub.add_parser("login", help="device-code sign-in to Microsoft").set_defaults(func=cmd_login)
    sub.add_parser("whoami", help="show Microsoft and Teamwork identity and scopes").set_defaults(func=cmd_whoami)

    trackercmd.register(sub)
    teamwork.register(sub)
    handovercmd.register(sub)
    ytcmd.register(sub)
    videocmd.register(sub)
    blendercmd.register(sub)
    imagecmd.register(sub)

    args = parser.parse_args()
    try:
        args.func(args)
    except graph.AuthError as e:
        sys.exit(f"{e}")
    except teamwork.TeamworkError as e:
        sys.exit(f"{e}")
    except RuntimeError as e:
        sys.exit(f"{e}")
    except BrokenPipeError:
        pass  # piping into head is normal
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
